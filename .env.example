# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here

# AI Models (Separated by purpose)
# For Logic & Insights
VITE_GEMINI_API_KEY=your_gemini_api_key_here
# For Live Chat (placeholders for separation)
VITE_GROQ_API_KEY=your_groq_api_key_here
VITE_DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Security Features
VITE_RECAPTCHA_V3_SITEKEY=your_recaptcha_site_key_here

# Supabase (Future migration)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# App Configuration
VITE_APP_NAME=IoTank Fuel Intelligence Hub
VITE_APP_VERSION=2.0.0
VITE_DEFAULT_LOCALE=en
VITE_ENABLE_ANALYTICS=true

# Feature Flags
VITE_ENABLE_3D_MODELS=true
VITE_ENABLE_AR_MODE=false
VITE_ENABLE_VOICE_CONTROL=false
VITE_ENABLE_COLLABORATION=true
